# ============================================================================
# VLR_WF Git Ignore 配置
# ============================================================================

# Visual Studio 用户文件
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# 构建结果
[Dd]ebug/
[Rr]elease/
x64/
x86/
# [Bb]in/ 注释掉，改用下面更精确的规则
[Oo]bj/
[Ll]og/
*.exe
*.dll
*.lib
*.exp

# Visual Studio 缓存
.vs/
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# 编译中间文件
*.obj
*.o
*.pch
*.pdb
*.ilk
*.idb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log

# CUDA/PTX 编译输出
*.ptx
*.cubin
*.fatbin

# CMake 生成文件
build/
build2/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake
!CMakeLists.txt

# 输出目录（忽略bin下的文件，但不忽略目录本身）
bin/*.exe
bin/*.dll
bin/*.lib
bin/*.exp
bin/*.pdb
bin/*.png
bin/*.jpg
bin/*.ptx
bin/*.cu
bin/GPU_kernels/
# 但保留配置文件
!bin/*.ini
!bin/config_presets/

# IDE 配置
.idea/
*.sln.iml
.vscode/
*.code-workspace

# 测试和临时文件
*_test.exe
*_test.obj
*.bat.bak
compile_test.bat
build_log.txt

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 备份文件
*~
*.bak
*.swp
*.orig

# Python
__pycache__/
*.pyc
*.pyo

# Scripts 文件夹（无用脚本）
scripts/

# 文档临时文件
*.tmp.md

# Tools 文件夹（教学文档和示意图）
# 不忽略 - 保留用于教学目的
# tools/

# Viewer外部依赖临时文件
viewer/external/assimp/temp/
viewer/external/assimp/build/
viewer/external/taskflow/temp/
viewer/external/taskflow/extracted/

# 模型文件（体积大，不纳入版本控制）
models/
